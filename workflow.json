          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1320, 300],
      "id": "b71f2a10-0006-4b7e-9a3d-1a2b3c4d0006",
